<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MiPresentacion.MainWindow"
        Title="MiPresentacion"
        Width="450" Height="450">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Mi primera aplicación gráfica" FontSize="22" FontWeight="Bold"/>

        <TextBox x:Name="TxtNombre" Watermark="Nombre"/>
        <TextBox x:Name="TxtApellido" Watermark="Apellido"/>
        <TextBox x:Name="TxtEdad" Watermark="Edad"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="BtnPresentarme" Content="Presentarme" Click="BtnPresentarme_Click"/>
            
            
        </StackPanel>

        <TextBlock x:Name="TxtResultado" Text="Completa tus datos y presiona Presentarme." TextWrapping="Wrap"/>
    </StackPanel>
</Window>